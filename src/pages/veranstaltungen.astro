---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/Veranstaltung.astro';
import Veranstaltung from '../components/Veranstaltung.astro';
const allPosts = Object.values(import.meta.glob('./veranstaltungen/*.md', { eager: true }));
const pageTitle = "Veranstaltungen";

// Sortieren nach Datum im Frontmatter
const sortedPosts = allPosts.sort(
  (b, a) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date)
);
---

<BaseLayout>
  <h2>Veranstaltungen</h2>
    <ul>
        {sortedPosts.map((post) => (
            <Veranstaltung url={post.url} post={post.frontmatter} />
        ))}
    </ul>
    <br style="clear: left;">
    <style>
        ul {
            list-style-type: none;
            padding-left: 0;
        }
    </style>
</BaseLayout>